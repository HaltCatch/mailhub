# MailHub 1.4.0：固定宿主机目录、垃圾邮件训练闭环、可选 SMTP Relay、可选 Authentik/OIDC。
# 复制为 .env，并替换所有 CHANGE_ME 值。
TZ=Asia/Shanghai

# 所有运行数据都固定保存在宿主机这个目录下。
DATA_ROOT=/mnt/data/docker/mail-hub

# Stalwart/JMAP 对外身份。TLS 由 NPMPlus 终止，再通过 HTTP 转发到 8443。
MAIL_HUB_HOSTNAME=hub.example.com
STALWART_PUBLIC_URL=https://hub.example.com

# 系统自动创建唯一的本地邮箱：admin@HUB_DOMAIN
HUB_DOMAIN=mail.example.com
STALWART_ADMIN_PASSWORD=CHANGE_ME_LONG_ADMIN_PASSWORD

# Collector -> Stalwart 的内部投递链路。
# 2525 只存在于 Docker 网络中，不发布到宿主机。
MAIL_HUB_MANAGE_COLLECTOR_TRUST=true
MAIL_HUB_COLLECTOR_SMTP_PORT=2525
SMTP_BATCH_LIMIT=8
COLLECTOR_HOSTNAME=collector.mailhub.internal

# 默认不拉取已经 Seen 的历史邮件，只按正常 IMAP/IDLE 语义收取新邮件。
# 如果需要首次全量导入历史邮件，可改为 true；也可以在单个 accounts/*.env 中覆盖。
COLLECTOR_FETCH_ALL_ON_FIRST_RUN=false

# Stalwart Bootstrap/TLS 配置。
STALWART_REQUEST_TLS_CERTIFICATE=false
MAIL_HUB_BOOTSTRAP_TIMEOUT=180

# 宿主机端口。
# 7080 仅绑定 127.0.0.1；8443 是供 NPMPlus 使用的 HTTP 后端。
STALWART_BOOTSTRAP_HOST_PORT=7080
STALWART_HTTP_HOST_PORT=8443
BULWARK_HOST_PORT=2000

# Bulwark Webmail 配置。
BULWARK_APP_NAME=Mail Hub
BULWARK_SESSION_SECRET=CHANGE_ME_RANDOM_SESSION_SECRET
BULWARK_TRUSTED_PROXY_DEPTH=1

# 可选：Authentik / OpenID Connect 单点登录。默认关闭，不影响原来的密码登录。
# 开启前先阅读 docs/AUTHENTIK_OIDC.md；最关键的是 username claim 必须最终映射为
# admin@HUB_DOMAIN，否则会被 Stalwart 视为另一个邮箱账号。
MAIL_HUB_OIDC_ENABLED=false
MAIL_HUB_OIDC_ISSUER_URL=
MAIL_HUB_OIDC_CLIENT_ID=
MAIL_HUB_OIDC_CLIENT_SECRET=
MAIL_HUB_OIDC_USERNAME_CLAIM=email
MAIL_HUB_OIDC_USERNAME_DOMAIN=
MAIL_HUB_OIDC_NAME_CLAIM=name
MAIL_HUB_OIDC_SCOPES=openid email profile offline_access
# OIDC 启用后建议保持 true，因为 Stalwart 会切换到外部 OIDC Directory。
MAIL_HUB_OIDC_ONLY=true
# 第一次联调建议 false；验证成功后可改为 true，访问 Webmail 会直接跳 Authentik。
MAIL_HUB_OIDC_AUTO_SSO=false
# 只有 Authentik 公网域名在 Bulwark 容器内解析成 RFC1918/loopback 地址时才开启。
MAIL_HUB_OIDC_ALLOW_PRIVATE_ENDPOINTS=false

# 垃圾邮件规则定时更新（小时）。Stalwart 官方没有内置更新周期；0 表示关闭。
MAIL_HUB_SPAM_RULES_UPDATE_HOURS=168
MAIL_HUB_SPAM_RULES_UPDATE_DELAY_SECONDS=300

# Collector 二次转投“每封邮件都会命中”的垃圾标签，分数置 0（约 6 分的固定误加分）。
# 这些标签是全局的；本项目没有公网 SMTP 入口，所有邮件都经 Collector，因此安全。
# 设为空（MAIL_HUB_COLLECTOR_NEUTRAL_TAGS=）关闭。
MAIL_HUB_COLLECTOR_NEUTRAL_TAGS=HELO_NOT_FQDN,HELO_NORES_A_OR_MX,FORGED_RECIPIENTS,FORGED_RCVD_TRAIL,DMARC_NA,RCVD_NO_TLS_LAST

# 可选：自定义递归 DNS。只有 X-Spam-Result 里出现 *_BLOCKED（DNS 黑名单拒绝公共 DNS）时才需要。
# 只能填 IP，逗号分隔，可带端口，例如 192.168.1.53 或 192.168.1.53:5353。
# 注意：AdGuard Home / Pi-hole 等“转发型”DNS 通常无效，必须是自己做递归查询的解析器。
MAIL_HUB_DNS_SERVERS=

# 可选：一次性训练器（docker compose run --rm trainer）的默认抽样数量，每个上游账号生效。
# 默认 ham 只取“已发送”；设为 true 会额外读取 INBOX。
TRAIN_SPAM_LIMIT=200
TRAIN_HAM_LIMIT=300
TRAIN_HAM_INCLUDE_INBOX=false

# 可选：SMTP Smart Host 外发（Bulwark 发信 -> Stalwart -> Relay -> 互联网）。默认关闭。
# 587 + STARTTLS：IMPLICIT_TLS=false；465：IMPLICIT_TLS=true。
MAIL_HUB_RELAY_ENABLED=false
MAIL_HUB_RELAY_HOST=
MAIL_HUB_RELAY_PORT=587
MAIL_HUB_RELAY_IMPLICIT_TLS=false
MAIL_HUB_RELAY_USERNAME=
MAIL_HUB_RELAY_PASSWORD=
