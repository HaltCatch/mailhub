ACCOUNT_NAME=gmail-main
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=your@gmail.com
IMAP_PASSWORD=CHANGE_ME_GOOGLE_APP_PASSWORD
IMAP_FOLDER=INBOX
FETCH_MODE=idle
POLL_INTERVAL=60
# 可选：覆盖默认本地收件人；默认是 admin@HUB_DOMAIN。
# LOCAL_RECIPIENT=admin@mail.example.com
IDLE_TIMEOUT=1680
# 可选：覆盖全局 COLLECTOR_FETCH_ALL_ON_FIRST_RUN；默认 false。
# FETCH_ALL_ON_FIRST_RUN=true
