ACCOUNT_NAME=netease-163
# 网易 163/126 的 IMAP 要求客户端发送 IMAP ID，Fetchmail 不支持（会报 mailbox selection failed /
# Unsafe Login），因此收信使用 POP3。需要在 163 网页端开启 “POP3/SMTP 服务”，授权码与 IMAP 通用。
PROTOCOL=POP3
IMAP_HOST=pop.163.com
IMAP_PORT=995
IMAP_USER=your@163.com
IMAP_PASSWORD=CHANGE_ME_163_AUTH_CODE
FETCH_MODE=poll
POLL_INTERVAL=60
# 可选：覆盖默认本地收件人；默认是 admin@HUB_DOMAIN。
# LOCAL_RECIPIENT=admin@mail.example.com
# 可选：覆盖全局 COLLECTOR_FETCH_ALL_ON_FIRST_RUN；默认 false。
# POP3 首次运行在 false 时只记录现有邮件、不投递；true 时导入 POP3 可见的全部邮件。
# FETCH_ALL_ON_FIRST_RUN=true
# trainer 需要读取垃圾邮件/已发送文件夹，仍走 IMAP（trainer 会发送 IMAP ID）。
# 注意：163 网页端的 “POP3/SMTP 服务” 与 “IMAP/SMTP 服务” 是两个独立开关，
# 只开 POP3 时 trainer 会登录失败，需要把 IMAP 服务也打开（授权码通用）。
TRAIN_IMAP_HOST=imap.163.com
TRAIN_IMAP_PORT=993
