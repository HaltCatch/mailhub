ACCOUNT_NAME=qq-main
IMAP_HOST=imap.qq.com
IMAP_PORT=993
IMAP_USER=123456789@qq.com
IMAP_PASSWORD=CHANGE_ME_QQ_AUTH_CODE
IMAP_FOLDER=INBOX
FETCH_MODE=idle
POLL_INTERVAL=60
# 可选：覆盖默认本地收件人；默认是 admin@HUB_DOMAIN。
# LOCAL_RECIPIENT=admin@mail.example.com
IDLE_TIMEOUT=1680
# 可选：覆盖全局 COLLECTOR_FETCH_ALL_ON_FIRST_RUN；默认 false。
# FETCH_ALL_ON_FIRST_RUN=true
